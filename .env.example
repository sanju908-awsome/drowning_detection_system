APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./drowning_watch.db
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
MAX_UPLOAD_MB=500
YOLO_MODEL=./models/drowning_best.pt
YOLO_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=640
DEEPSORT_MAX_AGE=30
DEEPSORT_N_INIT=3
DEEPSORT_MAX_COSINE_DISTANCE=0.3
POSE_ENABLED=true
POSE_MODEL=./models/pose_landmarker.task
RISK_MODEL=./models/risk_model.joblib
RISK_MIN_OBSERVATIONS=30
RISK_MIN_PROBABILITY=0.7
RISK_WARNING_CONFIRMATION_FRAMES=5
RISK_EMERGENCY_CONFIRMATION_FRAMES=3
RISK_CLEAR_CONFIRMATION_FRAMES=15
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
